{#
  Title: Mission
  Description: Editable voyage overview and milestones.
  Category: layout
  Icon: admin-comments
  PostTypes: page
  Mode: auto
  SupportsMode: false
#}
<section id="rejs" class="py-28 lg:py-40 bg-background {{ classes }}">
	<div class="max-w-[1400px] mx-auto">
		<div class="grid max-w-full overflow-hidden grid-cols-12 gap-10 lg:gap-16 mb-20">
			<div class="col-span-12 lg:col-span-6"><span class="eyebrow text-accent block mb-6">{{ fields.date_range|e }}</span><h2 class="text-4xl lg:text-[0.8rem]xl font-light leading-[1.05] tracking-tight">{{ fields.headline|e }}<br><em class="font-serif italic text-accent">{{ fields.headline_emphasis|e }}</em></h2></div>
			<p class="col-span-12 lg:col-span-6 text-base lg:text-lg text-ink/70 font-light leading-relaxed self-end">{{ fields.summary|e }}</p>
		</div>
		<div class="relative">
			<div class="absolute left-0 right-0 top-3 h-px bg-silver/30 hidden md:block"></div>
			<div class="grid max-w-full overflow-hidden grid-cols-2 md:grid-cols-4 gap-8">
				{% for item in fields.timeline %}
				<div class="relative"><div class="hidden md:block absolute top-2 left-0 w-2.5 h-2.5 rounded-full bg-accent ring-4 ring-background"></div><div class="md:pt-14 space-y-3"><div class="text-[0.6rem] tracking-[0.3em] uppercase text-flag font-semibold">{{ item.code|e }} · {{ item.year|e }}</div><div class="text-xl lg:text-2xl font-light leading-tight">{{ item.label|e }}</div><div class="text-xs tracking-[0.15em] uppercase text-silver">{{ item.location|e }}</div></div></div>
				{% endfor %}
			</div>
		</div>
		<blockquote class="mx-0 px-0 mt-24 max-w-3xl"><div class="text-accent font-serif italic text-5xl leading-none mb-4" aria-hidden="true">„</div><p class="font-serif italic text-2xl lg:text-3xl leading-snug text-ink/85">{{ fields.quote|e }}</p></blockquote>
	</div>
</section>
