{#
  Title: Join
  Description: Editable membership and support cards.
  Category: layout
  Icon: admin-comments
  PostTypes: page
  Mode: auto
  SupportsMode: false
#}
<section id="dolacz" class="py-28 lg:py-40 px-6 lg:px-16 bg-surface border-t border-border {{ classes }}" style="margin-bottom: calc(var(--wp--preset--spacing--60) * -1);">
	<div class="max-w-[1400px] mx-auto">
		<div class="text-center max-w-2xl mx-auto mb-20 space-y-6"><span class="eyebrow text-flag block">{{ fields.eyebrow|e }}</span><h2 class="text-4xl lg:text-[0.8rem]xl font-light tracking-tight leading-[1.05]">{{ fields.headline|e }}</h2></div>
		<div class="grid grid-cols-1 md:grid-cols-3 border border-border">
			{% for card in fields.cards %}
			<div class="group p-10 lg:p-14 flex flex-col bg-background hover:bg-surface transition-colors {{ not loop.last ? 'md:border-r' : '' }} border-border {{ not loop.first ? 'border-t md:border-t-0' : '' }}">
				<span class="font-serif italic text-sand text-sm mb-6">{{ '%02d'|format(loop.index) }}</span>
				<div class="text-xl lg:text-2xl font-light mb-4 leading-tight">{{ card.title|e }}</div>
				<p class="text-sm text-foreground/65 font-light leading-relaxed flex-1">{{ card.description|e }}</p>
				{% set card_url = card.destination ? card.destination : ko_mailto(card.email_to, card.email_subject, card.email_body) %}
				{% if card_url %}<a href="{{ card_url|esc_url }}" {% if card.destination %}target="_blank" rel="noopener noreferrer"{% endif %} class="mt-10 text-[0.65rem] tracking-[0.3em] uppercase font-semibold inline-flex items-center gap-3 group-hover:gap-5 transition-all text-accent">{{ card.button_label|e }}<span aria-hidden="true">→</span></a>{% endif %}
			</div>
			{% endfor %}
		</div>
	</div>
</section>
