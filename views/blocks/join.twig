<section id="dolacz" class="py-28 lg:py-40 px-6 lg:px-16 bg-surface border-t border-border {{classes}}" style="margin-bottom: calc(var(--wp--preset--spacing--60) * -1);">
	<div class="max-w-[1400px] mx-auto">
		<div class="text-center max-w-2xl mx-auto mb-20 space-y-6">
			<span class="eyebrow text-flag block">Dołącz do nas</span>
			<h2 class="text-4xl lg:text-[0.8rem]xl font-light tracking-tight leading-[1.05]">Salony Kobiet Oceanów</h2>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 border border-border">
			<div class="group p-10 lg:p-14 flex flex-col bg-background hover:bg-surface transition-colors md:border-r border-border ">
				<span class="font-serif italic text-sand text-sm mb-6">01</span>
				<div class="text-xl lg:text-2xl font-light mb-4 leading-tight">Wesprzyj darowizną</div>
				<p class="text-sm text-foreground/65 font-light leading-relaxed flex-1">Patronite — regularne i jednorazowe wsparcie</p>
				<a href="https://patronite.pl/" target="_blank" class="mt-10 text-[0.65rem] tracking-[0.3em] uppercase font-semibold inline-flex items-center gap-3 group-hover:gap-5 transition-all text-accent">Patronite
					<span>→</span>
				</a>
			</div>
			<div class="group p-10 lg:p-14 flex flex-col bg-background hover:bg-surface transition-colors md:border-r border-border border-t md:border-t-0 border-border">
				<span class="font-serif italic text-sand text-sm mb-6">02</span>
				<div class="text-xl lg:text-2xl font-light mb-4 leading-tight">Zostań Członkinią</div>
				<p class="text-sm text-foreground/65 font-light leading-relaxed flex-1">Aktywnie współtwórz fundację</p>
				<a href="mailto:fundacja@kobietyoceanow.pl?subject=Wniosek%20o%20członkostwo/ka&body=Cześć,%20chcę%20zostać%członkiem/członkinią.%20Proszę%20o%20przesłanie%20wniosku." class="mt-10 text-[0.65rem] tracking-[0.3em] uppercase font-semibold inline-flex items-center gap-3 group-hover:gap-5 transition-all text-accent">Aplikuj
					<span>→</span>
				</a>
			</div>
			<div class="group p-10 lg:p-14 flex flex-col bg-background hover:bg-surface transition-colors  border-t md:border-t-0 border-border">
				<span class="font-serif italic text-sand text-sm mb-6">03</span>
				<div class="text-xl lg:text-2xl font-light mb-4 leading-tight">Ambasador / Ambasadorka</div>
				<p class="text-sm text-foreground/65 font-light leading-relaxed flex-1">Nieś ideę dalej w świat</p>
				<a href="mailto:fundacja@kobietyoceanow.pl?subject=Ambasador/ka&body=Cześć,%20chcę%20zostać%20ambasadorem/ambasadorką." class="mt-10 text-[0.65rem] tracking-[0.3em] uppercase font-semibold inline-flex items-center gap-3 group-hover:gap-5 transition-all text-accent">Dołącz
					<span>→</span>
				</a>
			</div>
		</div>
	</div>
</section>
